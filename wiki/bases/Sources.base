filters:
  and:
    - file.inFolder("wiki/sources")
    - file.ext == "md"
formulas:
  is_part: kind == "source-part"
  is_moc: kind == "source"
  has_parent: parent != null
  has_parts: number(parts) > 1
  is_extracted: extraction == "pdftotext-layout"
  is_canonical: status == "canonical"
  is_draft: status == "draft"
  source_id: source_id
  tags_count: list(tags).length
  covers_count: list(covers).length
  code_count: list(code).length
  dimensions_count: list(dimensions).length
  symbols_count: list(symbols).length
properties:
  id:
    displayName: ID
  title:
    displayName: Title
  kind:
    displayName: Kind
  status:
    displayName: Status
  part:
    displayName: Part
  parts:
    displayName: Parts
  parent:
    displayName: Parent
  lines:
    displayName: Lines
  extracted:
    displayName: Extracted
  extraction:
    displayName: Extraction
views:
  - type: table
    name: All Sources
    order:
      - file.name
      - id
      - kind
      - status
  - type: table
    name: Source MOCs
    filters:
      and:
        - kind == "source"
    order:
      - id
      - title
      - status
  - type: table
    name: Source Parts
    filters:
      and:
        - kind == "source-part"
    order:
      - id
      - title
      - part
  - type: table
    name: By Status
    groupBy:
      property: status
      direction: ASC
    order:
      - status
      - id
      - title
  - type: table
    name: Canonical
    filters:
      and:
        - status == "canonical"
    order:
      - id
      - title
  - type: table
    name: Drafts
    filters:
      and:
        - status == "draft"
    order:
      - id
      - title
  - type: table
    name: Extracted
    filters:
      and:
        - extraction == "pdftotext-layout"
    order:
      - id
      - title
  - type: table
    name: With Covers
    filters:
      and:
        - list(covers).length > 0
    order:
      - id
      - title
  - type: table
    name: With Code
    filters:
      and:
        - list(code).length > 0
    order:
      - id
      - title
  - type: table
    name: With Dimensions
    filters:
      and:
        - list(dimensions).length > 0
    order:
      - id
      - title
  - type: table
    name: With Symbols
    filters:
      and:
        - list(symbols).length > 0
    order:
      - id
      - title
  - type: table
    name: Multi-Part
    filters:
      and:
        - number(parts) > 1
    order:
      - id
      - title
  - type: table
    name: Source Index
    filters:
      and:
        - id == "SRC-99"
    order:
      - id
      - title
