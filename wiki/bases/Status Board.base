filters:
  and:
    - file.inFolder("wiki/spec/60-verification")
    - file.ext == "md"
formulas:
  is_tests: id == "SPEC-60"
  is_status: id == "SPEC-61"
  is_draft: status == "draft"
  is_canonical: status == "canonical"
  sources_count: list(sources).length
  code_count: list(code).length
  dimensions_count: list(dimensions).length
  symbols_count: list(symbols).length
  tags_count: list(tags).length
properties:
  id:
    displayName: ID
  title:
    displayName: Title
  status:
    displayName: Status
views:
  - type: table
    name: Verification
    order:
      - file.name
      - id
      - title
  - type: table
    name: Test Vectors
    filters:
      and:
        - id == "SPEC-60"
    order:
      - id
      - title
  - type: table
    name: Implementation Status
    filters:
      and:
        - id == "SPEC-61"
    order:
      - id
      - title
  - type: table
    name: Drafts
    filters:
      and:
        - status == "draft"
    order:
      - id
      - title
  - type: table
    name: Canonical
    filters:
      and:
        - status == "canonical"
    order:
      - id
      - title
  - type: table
    name: With Sources
    filters:
      and:
        - list(sources).length > 0
    order:
      - id
      - title
  - type: table
    name: With Code
    filters:
      and:
        - list(code).length > 0
    order:
      - id
      - title
